# --------------------------------------------------------------------------
# The agent loop.
#
# One turn is: stream a response, hand back any tool calls Claude made, and
# stream again — repeating until Claude stops asking for tools or the
# iteration cap is reached. Everything the caller needs to render is emitted
# as an ``AgentEvent``.
# --------------------------------------------------------------------------
import logging
from collections.abc import AsyncIterator
from typing import Any

from anthropic import AsyncAnthropic

from src.app.core.config import settings
from src.app.llm.tools import TOOL_SCHEMAS, run_tool
from src.app.memory.base import ConversationStore, Message
from src.app.schemas.chat import AgentEvent

logger = logging.getLogger("app.agent")


def _serialize(block: Any) -> dict[str, Any]:
    """Content blocks come back as SDK models; store them as plain dicts."""
    if hasattr(block, "model_dump"):
        dumped: dict[str, Any] = block.model_dump()
        return dumped
    return dict(block)


class ChatAgent:
    """Streams a Claude conversation, executing tool calls as they arrive."""

    def __init__(
        self,
        client: AsyncAnthropic,
        store: ConversationStore,
        *,
        model: str | None = None,
        max_tokens: int | None = None,
        system_prompt: str | None = None,
        max_tool_iterations: int | None = None,
    ) -> None:
        self._client = client
        self._store = store
        self._model = model or settings.LLM_MODEL
        self._max_tokens = max_tokens or settings.LLM_MAX_TOKENS
        self._system_prompt = system_prompt or settings.SYSTEM_PROMPT
        self._max_tool_iterations = max_tool_iterations or settings.MAX_TOOL_ITERATIONS

    async def stream(
        self, conversation_id: str, user_message: str
    ) -> AsyncIterator[AgentEvent]:
        """Run one user turn, yielding events until the assistant is done."""
        history: list[Message] = await self._store.get(conversation_id)
        turn: list[Message] = [{"role": "user", "content": user_message}]

        for _ in range(self._max_tool_iterations):
            async with self._client.messages.stream(
                model=self._model,
                max_tokens=self._max_tokens,
                system=self._system_prompt,
                messages=history + turn,
                tools=TOOL_SCHEMAS,
            ) as stream:
                async for text in stream.text_stream:
                    yield AgentEvent(type="token", text=text)
                final = await stream.get_final_message()

            usage = getattr(final, "usage", None)
            input_tokens = getattr(usage, "input_tokens", 0) or 0
            output_tokens = getattr(usage, "output_tokens", 0) or 0
            logger.info(
                "llm turn complete model=%s stop_reason=%s "
                "input_tokens=%d output_tokens=%d",
                self._model,
                final.stop_reason,
                input_tokens,
                output_tokens,
            )
            yield AgentEvent(
                type="usage",
                input_tokens=input_tokens,
                output_tokens=output_tokens,
            )

            turn.append(
                {
                    "role": "assistant",
                    "content": [_serialize(block) for block in final.content],
                }
            )

            if final.stop_reason != "tool_use":
                await self._store.append(conversation_id, *turn)
                yield AgentEvent(type="done", conversation_id=conversation_id)
                return

            tool_results: list[dict[str, Any]] = []
            for block in final.content:
                if getattr(block, "type", None) != "tool_use":
                    continue
                arguments: dict[str, Any] = dict(block.input or {})
                yield AgentEvent(
                    type="tool_use", tool_name=block.name, tool_input=arguments
                )
                output = run_tool(block.name, arguments)
                yield AgentEvent(
                    type="tool_result", tool_name=block.name, tool_output=output
                )
                tool_results.append(
                    {
                        "type": "tool_result",
                        "tool_use_id": block.id,
                        "content": output,
                    }
                )

            # Tool results are sent back as a single user message, as the
            # Messages API requires.
            turn.append({"role": "user", "content": tool_results})

        # Fell out of the loop: Claude kept asking for tools.
        await self._store.append(conversation_id, *turn)
        logger.warning(
            "tool loop hit the iteration cap (%d) for conversation %s",
            self._max_tool_iterations,
            conversation_id,
        )
        yield AgentEvent(
            type="error",
            detail=(
                "The assistant exceeded the tool-call limit of "
                f"{self._max_tool_iterations} iterations."
            ),
        )
