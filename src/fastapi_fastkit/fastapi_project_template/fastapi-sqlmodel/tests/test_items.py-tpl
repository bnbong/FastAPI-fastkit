# --------------------------------------------------------------------------
# Items domain — end-to-end coverage of the CRUD endpoints.
# --------------------------------------------------------------------------
from httpx import AsyncClient
from src.app.core.config import settings

ITEMS_URL = f"{settings.API_V1_PREFIX}/items"


async def test_list_items_starts_empty(client: AsyncClient) -> None:
    response = await client.get(ITEMS_URL)

    assert response.status_code == 200
    body = response.json()
    assert body["items"] == []
    assert body["total"] == 0


async def test_create_then_read_item(
    client: AsyncClient, item_payload: dict[str, object]
) -> None:
    create_response = await client.post(ITEMS_URL, json=item_payload)

    assert create_response.status_code == 201
    created = create_response.json()
    assert created["id"] == 1
    assert created["name"] == "Sticker"
    assert created["in_stock"] is True

    read_response = await client.get(f"{ITEMS_URL}/{created['id']}")

    assert read_response.status_code == 200
    assert read_response.json() == created


async def test_get_unknown_item_returns_404(client: AsyncClient) -> None:
    response = await client.get(f"{ITEMS_URL}/999")

    assert response.status_code == 404


async def test_partial_update_leaves_other_fields_alone(
    client: AsyncClient, item_payload: dict[str, object]
) -> None:
    created = (await client.post(ITEMS_URL, json=item_payload)).json()

    response = await client.patch(f"{ITEMS_URL}/{created['id']}", json={"price": 11.0})

    assert response.status_code == 200
    body = response.json()
    assert body["price"] == 11.0
    assert body["name"] == created["name"]
    assert body["description"] == created["description"]


async def test_delete_item(
    client: AsyncClient, item_payload: dict[str, object]
) -> None:
    created = (await client.post(ITEMS_URL, json=item_payload)).json()

    delete_response = await client.delete(f"{ITEMS_URL}/{created['id']}")
    assert delete_response.status_code == 204

    follow_up = await client.get(f"{ITEMS_URL}/{created['id']}")
    assert follow_up.status_code == 404


async def test_create_item_validates_payload(client: AsyncClient) -> None:
    response = await client.post(ITEMS_URL, json={"name": "", "price": -1.0})

    assert response.status_code == 422


async def test_pagination_reports_total_and_window(client: AsyncClient) -> None:
    for index in range(5):
        await client.post(ITEMS_URL, json={"name": f"Item {index}", "price": 1.0})

    response = await client.get(ITEMS_URL, params={"offset": 2, "limit": 2})

    assert response.status_code == 200
    body = response.json()
    assert body["total"] == 5
    assert body["offset"] == 2
    assert body["limit"] == 2
    assert [item["name"] for item in body["items"]] == ["Item 2", "Item 3"]
