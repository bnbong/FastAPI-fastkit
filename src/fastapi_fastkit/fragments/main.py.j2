@app.get("/", tags=["Health"])
async def root() -> dict[str, str]:
    return {
        "message": {{ ("Welcome to " ~ project_name) | tojson }},
        "status": "healthy",
    }


@app.get("/health", tags=["Health"])
async def health_check() -> dict[str, str]:
    """Liveness probe — the process is up."""
    return {"status": "ok"}


@app.get("/ready", tags=["Health"])
async def readiness_check() -> dict[str, str]:
    """Readiness probe — the app is ready to serve traffic.

    Extend this with real dependency checks (database ping, cache ping)
    before pointing an orchestrator's readiness probe at it.
    """
    return {"status": "ready"}


