"""Celery application and example tasks.

Run the worker next to the API with::

    celery -A {{ pkg }}.worker.celery_app worker --loglevel=info
"""

import os
from typing import Any

from celery import Celery
from celery.utils.log import get_task_logger

BROKER_URL = os.getenv("CELERY_BROKER_URL", "redis://localhost:6379/0")
RESULT_BACKEND = os.getenv("CELERY_RESULT_BACKEND", BROKER_URL)

celery_app = Celery("{{ project_slug }}", broker=BROKER_URL, backend=RESULT_BACKEND)
celery_app.conf.update(
    task_serializer="json",
    result_serializer="json",
    accept_content=["json"],
    timezone="UTC",
    enable_utc=True,
    task_track_started=True,
    # Re-deliver a task if the worker dies mid-flight.
    task_acks_late=True,
    worker_prefetch_multiplier=1,
)

logger = get_task_logger(__name__)


@celery_app.task(
    bind=True,
    name="{{ pkg }}.worker.example_task",
    autoretry_for=(Exception,),
    retry_backoff=True,
    retry_jitter=True,
    max_retries=3,
)
def example_task(self: Any, payload: dict[str, Any]) -> dict[str, Any]:
    """Example task: echoes its payload back after a bit of "work".

    ``autoretry_for`` + ``retry_backoff`` retries on any exception with an
    exponential backoff, up to ``max_retries`` attempts.
    """
    logger.info("processing task %s attempt %s", self.request.id, self.request.retries)
    return {"received": payload, "task_id": self.request.id}
