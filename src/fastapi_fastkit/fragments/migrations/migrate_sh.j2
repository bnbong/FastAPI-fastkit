#!/usr/bin/env bash
# --------------------------------------------------------------------------
# Alembic migration helper
# Generated by FastAPI-fastkit
# --------------------------------------------------------------------------
set -euo pipefail

cd "$(dirname "$0")/.."

case "${1:-upgrade}" in
  upgrade)
    alembic upgrade "${2:-head}"
    ;;
  downgrade)
    alembic downgrade "${2:--1}"
    ;;
  revision)
    if [ $# -lt 2 ]; then
      echo "usage: $0 revision \"message\"" >&2
      exit 1
    fi
    alembic revision --autogenerate -m "$2"
    ;;
  current)
    alembic current
    ;;
  history)
    alembic history --verbose
    ;;
  *)
    echo "usage: $0 {upgrade|downgrade|revision|current|history} [arg]" >&2
    exit 1
    ;;
esac
